<?xml version="1.0" encoding="utf-8"?>
<!--
    Bhaloo's face, as the launcher icon.

    Deliberately NO <monochrome> layer: when "Themed icons" is switched on
    (Android 13+), the launcher draws the monochrome layer instead of the
    photo, which would hide the entire point of this icon. Without one, a
    themed launcher falls back to this full-colour icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_photo" />
</adaptive-icon>
