    <!-- Dedication -->
    <string name="dedication_tagline">Made only for Bhaloo. No one else gets a copy.</string>
    <string name="dedication_tagline_hi">सिर्फ़ भालू के लिए ❤️</string>
    <string name="dedication_headline">For Bhaloo</string>
    <string name="dedication_body">Every reminder in here is in your name. It speaks to you, in your language, at the exact moment you asked it to. No accounts, no ads, no strangers — just one app that exists so you never have to keep everything in your head.</string>
    <string name="dedication_body_hi">भालू, ये ऐप सिर्फ़ तुम्हारे लिए बनाई गई है। अब कुछ भी भूलने की ज़रूरत नहीं।</string>
    <string name="signature_anonymous">Made by hand, for Bhaloo.</string>
    <string name="signature_named">Made by hand for Bhaloo, by %1$s.</string>
    <string name="made_by_line">Created by %1$s</string>
    <string name="easter_egg_hint">Tap Bhaloo\'s photo a few times…</string>
    <string name="easter_egg_title">Arre Bhaloo! 🐻</string>
    <string name="easter_egg_body">You found it. Ab toh yaad rakhna padega — someone actually built a whole app just so your day runs on time. Chai pee lo.</string>
    <string name="version_line">Bhaloo\'s Reminders · v1.4</string>

